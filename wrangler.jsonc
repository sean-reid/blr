{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blr",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },
	"ai": { "binding": "AI" },
	"kv_namespaces": [{ "binding": "BUDGET", "id": "bb0be48a2cf1493fadf36112d6ece9b6" }],
	"ratelimits": [
		{ "name": "RATE", "namespace_id": "1001", "simple": { "limit": 40, "period": 60 } }
	],
	"r2_buckets": [{ "binding": "SHARE", "bucket_name": "blr-share" }],
	"routes": [{ "pattern": "blr.dwainosaur.com", "custom_domain": true }],
	"vars": { "AI_MODE": "live", "TURNSTILE_SITE_KEY": "", "DAILY_NEURONS": "9000" }
}
